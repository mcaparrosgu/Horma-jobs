# Producción (RF-4.6c). Copia este archivo a `.env.produccion` y rellénalo. NUNCA se versiona.
# Todos los secretos deben ser DISTINTOS a los de desarrollo; la API no arranca con valores
# vacíos, de ejemplo o cortos.
# Uso: docker compose --env-file .env.produccion -f docker-compose.yml -f docker-compose.prod.yml up -d

# Dominio público (con `localhost`, Caddy usa su CA interna y hay HTTPS local con aviso del navegador)
HORMA_DOMINIO=
# IP donde escucha el proxy: vacío = todas (servidor). En local, `127.0.0.1` si el 443 está ocupado.
HORMA_IP_PUBLICA=
APP_ENV=produccion
LOG_LEVEL=info

# Base de datos (contraseñas largas y únicas)
POSTGRES_USER=horma
POSTGRES_PASSWORD=
POSTGRES_DB=horma
HORMA_MIGRADOR_PASSWORD=
HORMA_APP_PASSWORD=
DATABASE_URL_MIGRACIONES=

# Secreto de la sesión: al menos 32 caracteres aleatorios (p. ej. `python -c "import secrets; print(secrets.token_urlsafe(48))"`)
SESSION_SECRET=

# Google OAuth: la URI de retorno DEBE ser https
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Modelo
ANTHROPIC_API_KEY=

# Administración, ritmo y topes (los valores por defecto están en `.env.example`)
HORMA_ADMINS=
HORMA_FLOW_IMPL=langgraph
LIMITE_LOGIN_POR_MINUTO=20
LIMITE_CV_POR_MINUTO=10
LIMITE_CANDIDATURAS_POR_MINUTO=10
