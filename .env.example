# Base de datos (Postgres en Docker Compose)
POSTGRES_USER=horma
POSTGRES_PASSWORD=
POSTGRES_DB=horma
POSTGRES_PORT=5434
# Roles de la aplicación (los crea docker/postgres/01-roles.sh)
HORMA_MIGRADOR_PASSWORD=
HORMA_APP_PASSWORD=
# URL de la aplicación (rol horma_app) y de las migraciones (rol horma_migrador)
DATABASE_URL=postgresql+psycopg://horma_app:<HORMA_APP_PASSWORD>@127.0.0.1:5434/horma
DATABASE_URL_MIGRACIONES=postgresql+psycopg://horma_migrador:<HORMA_MIGRADOR_PASSWORD>@127.0.0.1:5434/horma
# Puerta única del modelo (solo la usa horma.llm)
ANTHROPIC_API_KEY=
# Autenticación (fase 0: Google OAuth 2.0; sesión en cookie segura)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
SESSION_SECRET=
# Aplicación
APP_ENV=development
LOG_LEVEL=info
# Ejecutar los flujos en línea, sin cola ni worker (solo desarrollo)
HORMA_FLUJO_EN_LINEA=false
# Tope de coste (USD) y de reintentos por tarea de la cola
TOPE_COSTE_TAREA=0.50
TOPE_REINTENTOS_TAREA=3
# Fase 1 · Administración: identificadores `sub` de Google separados por comas. Tu `sub` sale en la
# página principal al entrar. Solo ellas ven el dashboard /ingesta.
HORMA_ADMINS=
# Fase 1 · Límite de ofertas por minuto y por clave de API (POST /ofertas)
LIMITE_OFERTAS_POR_MINUTO=60
# Fase 1 · Ingestor y consola: hablan con la API, nunca con la base de datos
HORMA_API_URL=http://127.0.0.1:8000
# Clave con alcance «ingesta»; se crea en /ingesta y solo se enseña una vez
HORMA_CLAVE_INGESTA=
# Fuentes de ofertas: una variable por clave declarada en `variable_clave` de cada fuente.
# Solo las lee el ingestor. Arbeitnow no necesita clave; Adzuna sí (si se activa):
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# n8n (solo si USE_N8N=true) — Horma no lo usa
# N8N_MCP_TOKEN=
# N8N_BASE_URL=
