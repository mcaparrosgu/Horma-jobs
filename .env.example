# Base de datos (Postgres en Docker Compose)
POSTGRES_USER=horma
POSTGRES_PASSWORD=
POSTGRES_DB=horma
DATABASE_URL=
# Puerta única del modelo (solo la usa horma.llm)
ANTHROPIC_API_KEY=
# Autenticación (fase 0: Google OAuth 2.0; sesión en cookie segura)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
SESSION_SECRET=
# Aplicación
APP_ENV=development
LOG_LEVEL=info
# Fuentes de ofertas: una variable por fuente registrada, referenciada desde la tabla `fuentes`
# (p. ej. ADZUNA_APP_ID=, ADZUNA_APP_KEY=); se añaden al activar cada fuente
# n8n (solo si USE_N8N=true) — Horma no lo usa
# N8N_MCP_TOKEN=
# N8N_BASE_URL=
